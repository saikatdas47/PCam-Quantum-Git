65" width="190" height="123" as="geometry" /></mxCell><mxCell id="n7" value="96 × 96 RGB patches&#10;Resize to 224 × 224&#10;Normalize (ImageNet)&#10;No augmentation" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#222222;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="70" width="172" height="113" as="geometry" /></mxCell><mxCell id="encoder" value="" style="rounded=0;html=0;fillColor=#F1F5F8;strokeColor=#597187;strokeWidth=1.2;dashed=0;" vertex="1" parent="1"><mxGeometry x="510" y="65" width="200" height="123" as="geometry" /></mxCell><mxCell id="n9" value="Frozen ResNet50&#10;ImageNet weights&#10;Global average pooling&#10;No fine tuning" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#222222;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="519" y="70" width="182" height="113" as="geometry" /></mxCell><mxCell id="cache" value="" style="rounded=0;html=0;fillColor=#F1F5F8;strokeColor=#597187;strokeWidth=1.2;dashed=0;" vertex="1" parent="1"><mxGeometry x="745" y="65" width="220" height="123" as="geometry" /></mxCell><mxCell id="n11" value="2,048 features / patch&#10;Shared frozen features&#10;Saved sample and WSI IDs&#10;Resumable feature cache" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#222222;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="754" y="70" width="202" height="113" as="geometry" /></mxCell><mxCell id="e12" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#53616E;strokeWidth=1.4;rounded=0;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="126" as="sourcePoint" /><mxPoint x="285" y="126" as="targetPoint" /></mxGeometry></mxCell><m